#include<iostream>
#include<string>
using namespace std;

int dp[10][10];

int lcs(string s1, string s2, int m, int n)
{
    if (m == 0 || n == 0)
        return 0;
    if (s1[m - 1] == s2[n - 1])
        return dp[m][n] = 1 + lcs(s1, s2, m - 1, n - 1);
  
    return dp[m][n] = max(lcs(s1,s2 ,m, n - 1),
                          lcs(s1,s2, m - 1, n));
}

int main()
{
	string s1 = "abcd";
	string s2 = "abcdkT";
 for(int i=0 ;i<s1.length(); i++) dp[0][i]=0;
 
 for(int i=0; i<s2.length(); i++) dp[i][0]=0;

	cout <<lcs(s1,s2, s1.size(), s2.size());

	return 0;
}

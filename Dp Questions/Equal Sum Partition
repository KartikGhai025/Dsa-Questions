#include <iostream>
using namespace std;

bool subSetSum(int arr[], int n, int sum)
{
	bool dp[n + 1][sum + 1];

	for (int i = 0; i <= n; i++)
		dp[i][0] = true;

	for (int i = 1; i <= sum; i++)
		dp[0][i] = false;

	for (int i = 1; i <= n; i++) {
		for (int j = 1; j <= sum; j++) {
			if (j < arr[i - 1])
				dp[i][j] = dp[i - 1][j];
			if (j >= arr[i - 1])
				dp[i][j] = dp[i - 1][j]
							or dp[i - 1][j - arr[i - 1]];
		}
	}

	return dp[n][sum];
}

bool equalSumP(int arr[], int n){
    int sum =0;
    for(int i=0; i< n; i ++){
        sum+=arr[i];
    }
    if(sum%2==0)
    return subSetSum(arr,n,sum);
    
    return false;
    
}


int main()
{
	int arr[] = {2,8,12 };

	int n = sizeof(arr) / sizeof(arr[0]);
	cout<<equalSumP(arr, n);
	return 0;
}

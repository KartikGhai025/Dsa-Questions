using namespace std;

string kWords(string str, int k)
{
    int i=0,n=0;
    while(i<str.length())
    {
        
        if(n==k){
            break;
        }
        if(str[i]==' ')
        n++;
         
         i++;
        
    }
    if(i==str.length()){
        return str;
    }
    
    return str.substr(0, i-1);
    
    
    
}


int patternSearch2(string s1, string s2) {
    unordered_map<string, int> mp;
    int n = s2.length();
    mp[s2]++;
    
    string temp = s1.substr(0, n); 
    
    for (int i = 0; i <= s1.length() - n; i++) {
        if (mp[temp] == 1) {
            return i;
        }
        
        temp = temp.substr(1); 
        temp += s1[i + n];     
    }
    
    return -1;
}



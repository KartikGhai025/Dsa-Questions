#include <bits/stdc++.h>
using namespace std;

bool searchMat(int mat[4][4], int n, int key){
    int ans = false;
    int i=0;
    int j= n-1;
    while(i<n && j>=0)
    {
        if(mat[i][j]== key){
            ans =true;
            return true;
        }
      
       else if(mat[i][j]> key){
            j--;
        }
        else  {
            i++;
        }
        
    }
    return ans;
    
}


int main() {
     int mat[4][4] = { { 10, 20, 30, 40 },
                      { 15, 25, 35, 45 },
                      { 27, 29, 37, 48 },
                      { 32, 33, 39, 50 } };
                      
                      cout<<searchMat(mat, 4, 32);
                      
    return 0;
}

#include <bits/stdc++.h>
using namespace std;

void setMatrixZero(int mat[][100],int m, int n ){
    
    int col;
    
    for(int i=0; i<m; i++){
        for(int j=0; j<n; j++){
            if(mat[i][j]==0){
                if(j==0){
                    col=0;
                }
                else {
                    mat[0][j]=0;
                    mat[i][0]=0;
                    
                }
            }
       
        }
    }
    
    for(int i=1; i<m; i++){
        for(int j=1; j<n; j++){
            if(mat[i][0]== 0 || mat[0][j]==0){
                mat[i][j]=0;
            }
        }
    }
    if(mat[0][0]==0){
        for(int i=0; i<n; i++)
        mat[0][i]=0;
    }
    
    if(col==0)
     for(int i=0; i<m; i++)
     mat[i][0]=0;
    
    
}
int main() {
   int arr[][100]= {
       {0,1,1},
       {1,1,1},
       {1,1,0}
   };
   setMatrixZero(arr, 3,3);
   
   for(int i=0; i< 3; i++){
       for(int j=0; j<3; j++){
           cout<<arr[i][j]<<" ";
       }
       cout<<endl;
   }

    return 0;
}

#include <iostream>
using namespace std;

void spiralMat(int mat[][100], int m, int n) {
    int k = 0;
    int l = 0;

    while (k < m && l < n) {
        for (int i = l; i < n; i++) {
            cout << mat[k][i] << " ";
        }
        k++;

        for (int i = k; i < m; i++) {
            cout << mat[i][n - 1] << " ";
        }
        n--;

        if (k < m) {
            for (int i = n - 1; i >= l; i--) {
                cout << mat[m - 1][i] << " ";
            }
            m--;
        }
        if (l < n) {
            for (int i = m - 1; i >= k; i--) {
                cout << mat[i][l] << " ";
            }
            l++;
        }
    }
}

int main() {
    int mat[][100] = { { 10, 20, 30, 40 },
                      { 15, 25, 35, 45 },
                      { 27, 29, 37, 48 },
                      { 32, 33, 39, 50 } };

    spiralMat(mat, 4, 4);

    return 0;
}

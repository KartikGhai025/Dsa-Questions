    vector<int> leaders(int a[], int n){
   vector<int> ans;
        int maxVal = a[n-1];
        ans.push_back(maxVal);
        for(int i = n-2; i>=0; i--){
            if(a[i] >= maxVal){
                maxVal = a[i];
                ans.push_back(maxVal);
            }
        }
        reverse(ans.begin(), ans.end());
        return ans;
    }

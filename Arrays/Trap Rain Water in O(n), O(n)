#include <iostream>
using namespace std;

int trapRain(int arr[], int n){
    int heightLeft[n];
    int heightRight[n];
    heightLeft[0]= arr[0];
heightRight[n-1]= arr[n-1];
    for(int i=1; i<n ;i++){
        heightLeft[i]= max(arr[i],heightLeft[i-1]);
        heightRight[n-1-i]= max(arr[n-1-i], heightRight[n-1-i+1] );
    }
    
    int maxWater=0;
    
    for(int i=0; i< n; i++){
        maxWater+=(min(heightLeft[i],heightRight[i])- arr[i]);
    }
    
    return maxWater;
    
}
int main() {
    int arr[]= {3,1,2,4,0,1,3,2};
    int n= sizeof(arr)/sizeof(arr[0]);
    cout<<trapRain(arr,n);
    return 0;
}

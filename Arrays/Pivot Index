// https://leetcode.com/problems/find-pivot-index/
#include <bits/stdc++.h>
using namespace std;

int pivotIndex(int arr[], int n){
    
    int sum=0, currSum=0;
    
    for(int i=0; i<n; i++)
    sum+=arr[i];
    
    for(int i=0; i<n; i++){
        if(currSum == sum-arr[i]- currSum)
            return i;
            
        currSum+=arr[i];    
    }
     return -1;
    
}


int main() {
    int arr[]= {1,6,7,7};
    int n= sizeof(arr)/sizeof(arr[0]);
    
    cout<<pivotIndex(arr,n);
    
    return 0;
}

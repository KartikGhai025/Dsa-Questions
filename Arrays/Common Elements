//Given three arrays sorted in increasing order. Find the elements that are common in all three arrays.


 vector <int> commonElements (int A[], int B[], int C[], int n1, int n2, int n3)
        {
          
          set<int> brr;  
   vector<int> arr;
      int i = 0, j = 0, k = 0;
 
  
    while (i < n1 && j < n2 && k < n3) {
       
        if (A[i] == B[j] && B[j] == C[k]) {
            
           brr.insert(A[i]);
                
            
            i++;
            j++;
            k++;
        }
 
     
        else if (A[i] < B[j])
            i++;
 
       
        else if (B[j] < C[k])
            j++;
 
        
        else
            k++;
    }
    for(auto& i: brr)
  {
    arr.push_back(i);
  }
    
    return arr;
            
        }

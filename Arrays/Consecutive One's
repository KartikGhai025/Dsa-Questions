#include <iostream>
using namespace std;

int max1(int arr[],int n){
    int count=0; 
    int maxone=0;
    for(int i=0; i<n; i++){
        if(arr[i]==1){
            count++;
            maxone=max(count, maxone);
        }
    else{
        count=0;
    }        
    }
    return maxone;
}
int main() {
    int arr[]= {0,0,0,0,0,0,0,1,1};
    int n= sizeof(arr)/sizeof(arr[0]);
    cout<<max1(arr,n);
    return 0;
}

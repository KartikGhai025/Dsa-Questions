//Given two arrays a[] and b[] of size n and m respectively. The task is to find the number of elements in the union between these two arrays.

int doUnion(int a[], int n, int b[], int m)  {
        map<int,int> arr;
        for(int i=0; i<n; i++){
            arr[a[i]]++;
        }
        for(int i=0;i<m;i++){
            arr[b[i]]++;
        }
        return arr.size();
    }

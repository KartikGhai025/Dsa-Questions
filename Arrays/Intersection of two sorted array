#include <bits/stdc++.h>
using namespace std;

void intersection(int arr[], int brr[], int m, int n){
    int i=0;
    int j=0;
    
    while(i<m && j<n){
        if(arr[i]== arr[i-1] && i>0){
            i++;
            continue;
        }
        
     else if(arr[i]<brr[j]){
            i++;
        }
     else if(arr[i]>brr[j]){
            j++;
        }
        else{
            cout<<arr[j]<<endl;
            i++;
            j++;
        }
    }
}


int main() {
   int arr[]= {1,3,3,5,7};
  int brr[]= {1};
int n= sizeof(brr)/sizeof(brr[0]);
   int m= sizeof(arr)/sizeof(arr[0]);
   intersection(arr,brr,m,n);
   return 0;
}

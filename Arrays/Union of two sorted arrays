#include <bits/stdc++.h>
using namespace std;

void unionOfArray(int arr[], int brr[], int m, int n){
    int i = 0, j = 0;
    while (i < m && j < n) {
        if(i>0 && arr[i]==arr[i-1]) {
            i++;
            continue;
        }
        if(j>0 && brr[j]==brr[j-1]) {
            j++;
            continue;
        }
        if (arr[i] < brr[j])
            cout << arr[i++] << " ";
 
        else if (brr[j] < arr[i])
            cout << brr[j++] << " ";
 
        else {
            cout << brr[j++] << " ";
            i++;
        }
    }
 
  
    while (i < m)
    { if(i>0 && arr[i]==arr[i-1]) {
            i++;
            continue;
        }
        cout << arr[i++] << " ";
    }
    while (j < n){
     if(j>0 && brr[j]==brr[j-1]) {
            j++;
            continue;
        }
        cout << brr[j++] << " ";
}}


int main() {
   int arr[]= {1,3,3,5,7};
   int brr[]= {1,4,9,9};
   int n= sizeof(brr)/sizeof(brr[0]);
   int m= sizeof(arr)/sizeof(arr[0]);
   unionOfArray(arr,brr,m,n);
   return 0;
}

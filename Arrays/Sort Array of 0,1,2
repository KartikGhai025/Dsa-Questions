
void sort012(int a[], int n)
{
    //sort(a,a+n);
//return a;
 int low=0;
       int mid=0;
       int high=n-1;
       
       while(mid<=high)
       {
           if(a[mid]==0){
               int temp;
               temp= a[low];
               a[low]=a[mid];
               a[mid]=temp;
            //   swap(a[low],a[mid]);
               low++;
               mid++;
           }
           else if(a[mid]==1)
           mid++;
           else{
               int temp;
               //swap(a[mid],a[high]);
                temp= a[mid];
               a[mid]=a[high];
               a[high]=temp;
               high--;
           }
       }
    
}

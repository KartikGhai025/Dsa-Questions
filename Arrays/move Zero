#include<bits/stdc++.h>
using namespace std;

void moveZero(int arr[], int n){
	int k=0;
	for(int i=0; i<n;i++){
	if(arr[i]!= 0){
	swap(arr[k],arr[i]);
          k++;	
	    }	
	}
	for(int i=0; i<n; i++){
	cout<<arr[i]<<endl;
	}
}


int main(){
int arr[]= {10,0,0,0,0,10};
int n= sizeof(arr)/sizeof(arr[0]);
moveZero(arr, n);
}

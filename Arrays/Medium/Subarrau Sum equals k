// for subarray sum =0, just check if any prefix sum already exist in hash or not

#include <bits/stdc++.h>
using namespace std;

int subarraySum(int nums[], int n, int k) {
        int count=0;
        unordered_map<int, int> mp;
       mp[0]++;
        int pSum=0;
        
        for(int i=0; i<n; i++){
             pSum+=nums[i];
            
            mp[pSum]++;
            

            
            if(mp[pSum- k]!=0  )
                count++;
         
            }
        
        return count;
 
    }

 int subArraySum(vector<int> nums, int k) {
        int pSum = 0;
        int count = 0;
        
        unordered_map<int, int> mp;
        mp[0] = 1;
        
        for (int i = 0; i < nums.size(); i++) {
            pSum += nums[i];
          
            
            if (mp[pSum-k]!= 0) {
                count += mp[pSum-k];
            }
            
            mp[pSum] = mp[pSum] + 1;
        }
        
        return count;
    }

int main() {
   vector<int> arr{1,-1,0};
  
   
   cout<<subArraySum(arr,0);


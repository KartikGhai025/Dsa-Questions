// https://leetcode.com/problems/best-time-to-buy-and-sell-stock-ii/

int maxProfit(vector<int>& prices) {
        int profit =0;
        int min= prices[0];
        
        for(int i=1; i<prices.size(); i++)
        {
            if(prices[i]<min){
                min= prices[i];
            }
            else if(prices[i]>prices[i-1]){
                profit=profit+ prices[i]-prices[i-1];
            }
            else {
                min = prices[i];
            }
            
        }
        
        return profit;
        
        
    }

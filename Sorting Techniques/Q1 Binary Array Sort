#include <bits/stdc++.h>
using namespace std;

void binaryArraySort(int arr[], int n){
    int i=0, j=0;
    while(j<n){
        if(arr[j]==0){
            swap(arr[i++], arr[j++]);
            continue;
        }
        j++;
    }
}

int main() {
    int arr[10]= {1,0,1,1,1,0,0,1,1,0};
    binaryArraySort(arr,10);
    for(int i: arr){
        cout<<i<<endl;
    }
    return 0;
}

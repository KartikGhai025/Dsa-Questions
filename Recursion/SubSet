//https://leetcode.com/problems/subsets/

class Solution {
    
public:
    vector<vector<int>> subsets(vector<int>& nums) {
        vector<vector<int>> ans;
        subsetHelper(ans,nums,0,nums.size(), {});
        
        return ans;
        
        
        
    }
    
    void subsetHelper(vector<vector<int>> &ans, vector<int> & nums, int i, int n, vector<int> temp){
        
        if(i==n){
            ans.push_back(temp);
            return;
        }
        
        subsetHelper(ans,nums,i+1,n,temp);
        temp.push_back(nums[i]);
        subsetHelper(ans,nums,i+1,n,temp);
        
        
    }
    
};

#include<iostream>
#include<string>
using namespace std;

int cc(int coins[], int n , int sum){
    if(n==0) return 0;
    if(sum==0)return 1;
 if(sum<0 ) return 0;
    return cc(coins, n, sum-coins[n-1])+ cc(coins, n-1, sum);
}

int main()
{
	int coins[3]= {1,2,3};
int sum =4;
	cout <<cc(coins, 3 ,sum);

	return 0;
}
